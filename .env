# ===== Сборка образа =====
LLAMA_IMAGE=local/prism-llama.cpp:server-cuda-pq2
LLAMA_REPO=https://github.com/PrismML-Eng/llama.cpp.git
LLAMA_REF=prism
CUDA_ARCH=86
CUDA_VERSION=12.4
PARALLEL_JOBS=4

# ===== Сеть =====
API_PORT=8080
OLLAMA_PORT=11435

# ===== Модель =====
MODEL_ALIAS=bonsai-2-27b
MAIN_REPO=prism-ml/Ternary-Bonsai-2-27B-gguf
MAIN_FILE=Ternary-Bonsai-2-27B-PQ2_0.gguf
MODEL_PATH=/models/bonsai2-27b-pq20.gguf

# ===== Контекст и генерация =====
CTX_SIZE=65536
MAX_TOKENS=16384
GPU_LAYERS=99
BATCH_SIZE=2048
UBATCH_SIZE=256
TEMPERATURE=0.25
TOP_P=0.95
TOP_K=0
MIN_P=0.05
PRESENCE_PENALTY=0.1
REPEAT_PENALTY=1.05
REASONING_BUDGET=8192
FREQUENCY_PENALTY=0.25

# ===== Шаблон чата =====
TEMPLATE_REPO=Moore2877/Qwen-Fixed-Chat-Templates-llamacpp
TEMPLATE_REF=main
TEMPLATE_FILE=chat_template.jinja
CHAT_TEMPLATE=/models/templates/chat_template.jinja
CHAT_KWARGS={"tool_call_format":"xml","reasoning_effort":"medium","max_tool_response_chars":6000,"max_tool_arg_chars":3000,"skill_loader_tools":"skill skill_view view_skill","todo_tools":"todo todowrite update_plan"}

# ===== Vision =====
LOAD_VISION=0
MMPROJ_FILE=Ternary-Bonsai-2-27B-mmproj-Q8_0.gguf
MMPROJ_PATH=/models/bonsai2-27b-mmproj-q8_0.gguf

# ===== Вспомогательные модели (Ollama) =====
OLLAMA_NUM_GPU=0
EMBED_MODEL=nomic-embed-text